# Local development. On Render these are injected by the Blueprint.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/render_test
REDIS_URL=redis://localhost:6379
PORT=3001

# How often the outbox relay polls for pending events (ms)
RELAY_INTERVAL_MS=2000

# Set to true only when connecting to a Postgres that requires SSL (e.g. Render external URL)
DATABASE_SSL=false

# Auto-create the schema. Enable on exactly ONE process (the API). The relay and
# consumers should run with DB_SYNC unset so they don't race on CREATE TABLE.
DB_SYNC=true

# Render injects this automatically. Set it locally to label each consumer.
# RENDER_SERVICE_NAME=consumer-1
